--!strict
-- Reads art/models/*.styles.json (written by the Blender scripts) and writes src/shared/Game/ModelStyles.luau:
-- the colour and material of each part of each model, so imported meshes can be painted in game.
-- Run: lune run scripts/build-styles   (then: stylua src)
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local kinds = {}
for _, file in fs.readDir("art/models") do
	local kind = string.match(file, "^(.+)%.styles%.json$")
	if kind and kind ~= "night_manager" then
		table.insert(kinds, kind)
	end
end
table.sort(kinds)

local out = {
	"--!strict",
	"-- GENERATED by scripts/build-styles.luau from art/models/*.styles.json. Do not edit by hand.",
	"-- Colour and Roblox material for each part (by Blender object name) of each model.",
	"export type Style = { rgb: { number }, material: string }",
	"return {",
}
for _, kind in kinds do
	local styles = serde.decode("json", fs.readFile(`art/models/{kind}.styles.json`)) :: { [string]: { rgb: { number }, material: string } }
	local names = {}
	for name in styles do
		table.insert(names, name)
	end
	table.sort(names)
	table.insert(out, `\t{kind} = \{`)
	for _, name in names do
		local s = styles[name]
		table.insert(out, `\t\t["{name}"] = \{ rgb = \{ {s.rgb[1]}, {s.rgb[2]}, {s.rgb[3]} \}, material = "{s.material}" \},`)
	end
	table.insert(out, "\t},")
end
table.insert(out, "} :: { [string]: { [string]: Style } }")
fs.writeFile("src/shared/Game/ModelStyles.luau", table.concat(out, "\n") .. "\n")
print(`wrote ModelStyles for {#kinds} models`)
